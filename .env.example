# Copy to .env (never committed) and replace both passwords, e.g. with `openssl rand -hex 24`.
POSTGRES_DB=apex
POSTGRES_USER=apex
POSTGRES_PASSWORD=change-me
APP_DB_USER=apex_app
APP_DB_PASSWORD=change-me-too
APP_ENV=local
API_PORT=8088
# Optional: Pydantic Logfire write token. Leave empty to run without Logfire.
LOGFIRE_TOKEN=
